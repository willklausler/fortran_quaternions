#:set KINDS = [('sp', 'real32', False), ('dp', 'real64', False), ('qp', 'real128', True)]
#! INTS: (suffix, iso_fortran_env kind) of integers allowed in mixed arithmetic
#:set INTS = [('i8', 'int8'), ('i16', 'int16'), ('i32', 'int32'), ('i64', 'int64')]
#!
#:def BEGIN(g)
#:if g
#if QUATERNIONS_QP
#:endif
#:enddef
#:def END(g)
#:if g
#endif
